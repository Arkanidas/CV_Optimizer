
generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id            String @id @default(uuid())
  
  CvFileUrl     String 
  coverFileUrl  String?

  cvText        String
  coverText     String?
  createdAt     DateTime @default(now())
}
